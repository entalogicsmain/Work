{
  "name": "comeback",
  "version": "1.0.0",
  "private": true,
  "description": "Comeback - personal daily health tracker",
  "scripts": {
    "build:web": "node scripts/build-icons.mjs && esbuild src/native.js --bundle --minify --format=iife --target=chrome90 --outfile=www/vendor/native.js",
    "sync": "npm run build:web && cap sync android",
    "build:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "assets": "capacitor-assets generate --android",
    "test:web": "node test/web-test.mjs",
    "test:sync": "node test/sync-test.mjs",
    "test:real": "node test/real-test.mjs",
    "test:contrast": "node test/contrast-test.mjs",
    "test:steps": "node test/steps-test.mjs",
    "test:android": "cd android && ./gradlew :app:testDebugUnitTest",
    "lint:android": "cd android && ./gradlew :app:lintDebug",
    "brand": "node scripts/build-brand.mjs",
    "test:rename": "node test/rename-test.mjs",
    "test:responsive": "node test/responsive-test.mjs",
    "test:a11y": "node test/a11y-test.mjs",
    "test:permissions": "node test/permissions-test.mjs",
    "test:reminders": "node test/reminders-test.mjs",
    "test:refresh": "node test/refresh-test.mjs",
    "test:core": "node test/core-test.mjs",
    "test:retention": "node test/retention-test.mjs",
    "test:ux": "node test/ux-test.mjs",
    "test:widget": "node test/widget-test.mjs",
    "test:dates": "node test/dates-test.mjs",
    "test:structure": "node test/structure-test.mjs",
    "test:travel": "node test/travel-test.mjs",
    "test:photos": "node test/photos-test.mjs",
    "test:datasafety": "node test/datasafety-test.mjs",
    "test:theme-lock": "node test/theme-lock-test.mjs",
    "test": "node test/core-test.mjs && node test/dates-test.mjs && node test/structure-test.mjs && node test/web-test.mjs && node test/sync-test.mjs && node test/datasafety-test.mjs && node test/rename-test.mjs && node test/steps-test.mjs && node test/permissions-test.mjs && node test/refresh-test.mjs && node test/contrast-test.mjs && node test/a11y-test.mjs && node test/travel-test.mjs && node test/reminders-test.mjs && node test/ux-test.mjs && node test/retention-test.mjs && node test/theme-lock-test.mjs && node test/responsive-test.mjs && node test/widget-test.mjs && node test/photos-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.49.0",
    "playwright": "^1.63.0"
  }
}
