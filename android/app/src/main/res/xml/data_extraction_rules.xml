<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is copied by cloud backup or by phone-to-phone transfer. The app's stored data holds cloud sign-in tokens,
     health data and the step counter baseline, none of which is valid on another phone. Use Settings > Backup (JSON) to move data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
