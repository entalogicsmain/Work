<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: ring and percent on the left; streak or day label, steps, next open habit and "Open Comeback" on the right.
     The whole widget is one tap target that opens the app. The default texts only matter for the widget picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:baselineAligned="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ring_track" />

        <ImageView
            android:id="@+id/w_arc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_arc_preview" />

        <TextView
            android:id="@+id/w_percent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_preview_percent"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_preview_streak"
            android:textColor="@color/widget_accent_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_steps"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_next"
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_open"
            android:textColor="@color/widget_text2"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
